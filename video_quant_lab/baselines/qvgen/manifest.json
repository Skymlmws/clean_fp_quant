{
  "name": "qvgen",
  "source": {
    "url": "https://github.com/ModelTC/QVGen.git",
    "revision": "198e761f770fa0728e21da5e76b8198e41cbaf3b"
  },
  "repository": {
    "env": "QVGEN_REPO",
    "default": "video_quant_lab/baselines/qvgen"
  },
